APP_NAME="Quodara Chrono Foundation"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:18085
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Isolated Laravel key ONLY. Never paste legacy jwt.key/encryption.key here.
# Required for HTTP boot, including /up (encrypted session service resolution).
# No install hook generates or rotates this key. Provision separately and explicitly.
FRAMEWORK_APP_KEY=
FRAMEWORK_PREVIOUS_KEYS=

# Handoff metadata only; never opened by this foundation.
# Existing legacy keys/data stay unchanged and remain private, outside webroots.
# APP_DATA_DIR=/absolute/private/chrono
# CHRONO_DB_PATH=/absolute/private/chrono/timetracking.sqlite
# CHRONO_JWT_KEY_PATH=/absolute/private/chrono/jwt.key
# CHRONO_ENCRYPTION_KEY_PATH=/absolute/private/chrono/encryption.key

# Private, separate framework namespace. Defaults stay inside this denied tree.
FRAMEWORK_SESSION_DRIVER=file
# FRAMEWORK_SESSION_PATH=/absolute/private/chrono-framework/sessions
FRAMEWORK_CACHE_STORE=file
FRAMEWORK_CACHE_PREFIX=chrono-framework-cache-
# FRAMEWORK_CACHE_PATH=/absolute/private/chrono-framework/cache
# FRAMEWORK_CACHE_LOCK_PATH=/absolute/private/chrono-framework/cache-locks
# FRAMEWORK_FILES_PATH=/absolute/private/chrono-framework/files

# No database-backed sessions/cache/queue, Redis, mail integration or UI build.
