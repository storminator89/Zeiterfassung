# NEW local Laravel STANDARD settings. Copy outside checkout; paths/settings only, NO secrets.
# Linux operator and web runtime must use the SAME NONROOT UID/GID.
CHRONO_LARAVEL_UID=
CHRONO_LARAVEL_GID=
CHRONO_LARAVEL_PRIVATE_PARENT=
CHRONO_LARAVEL_IMAGE=chrono-laravel:local
# Set only after explicit prepare-fresh returns its new directory basename.
CHRONO_LARAVEL_INSTANCE=
# Fill existing trusted TLS/origin settings before deliberately starting the default web service.
CHRONO_LARAVEL_ORIGIN=
CHRONO_LARAVEL_HTTPS_PORT=
CHRONO_LARAVEL_TLS_CERTIFICATE=
CHRONO_LARAVEL_TLS_PRIVATE_KEY=
# NEW V5/V7 uses the stock non-expiring FileStore lease, with a positive wait.
# Worker-exit leftovers require the unchanged verified-stopped cleanup contract.
CHRONO_LARAVEL_SESSION_LOCK_SECONDS=0
CHRONO_LARAVEL_SESSION_WAIT_SECONDS=10
CHRONO_LARAVEL_SETUP_ENABLED=false

# V5/V7 shared budget is required before setup and afterwards. Not a secret.
# Never append flags to generated key environment files.
CHRONO_LARAVEL_SHARED_LOGIN_BUDGET_ENABLED=true
