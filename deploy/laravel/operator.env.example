# COPY OUTSIDE THE CHECKOUT and edit privately. NO secrets belong in this file.
# Linux operator and web runtime must use the SAME NONROOT UID/GID.
CHRONO_LARAVEL_UID=
CHRONO_LARAVEL_GID=
CHRONO_LARAVEL_PRIVATE_PARENT=
CHRONO_LARAVEL_IMAGE=chrono-laravel:local
# Set only after explicit prepare-fresh returns its new directory basename.
CHRONO_LARAVEL_INSTANCE=
# Web settings are intentionally incomplete; there is no automatic activation.
CHRONO_LARAVEL_ORIGIN=
CHRONO_LARAVEL_HTTPS_PORT=
CHRONO_LARAVEL_TLS_CERTIFICATE=
CHRONO_LARAVEL_TLS_PRIVATE_KEY=
CHRONO_LARAVEL_SESSION_LOCK_SECONDS=
CHRONO_LARAVEL_SESSION_WAIT_SECONDS=
CHRONO_LARAVEL_SETUP_ENABLED=false

# Preserve the original V4 default. Explicitly reviewed NEW V5 requires true
# before its first Web setup request and afterwards. This is not a secret;
# configure it here, never by editing the generated key environment files.
CHRONO_LARAVEL_SHARED_LOGIN_BUDGET_ENABLED=false
